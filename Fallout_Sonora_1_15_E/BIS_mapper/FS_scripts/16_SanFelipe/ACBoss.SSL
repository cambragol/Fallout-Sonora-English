   bitDialogExp(bit_1,0)
   Reply(200)
   if DudeTraitHas(TRAIT_espanol) then begin
      GAnswer(202,0,NodeFstDialog002)
   end
   else begin
      NAnswer(201,0,NodeFstDialog003)
   end
end

