procedure NodeAnswer200 begin
   inc_local_var(LVAR_Party_Status);
   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_TEAM_NUM,TEAM_PLAYER);
   rm_timer_event(self_obj);
   Reply(301)
   NAnswer(302,4,Node999)
end

procedure NodeAnswer201 begin
   inc_local_var(LVAR_Party_Status);
   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_TEAM_NUM,TEAM_PLAYER);
   rm_timer_event(self_obj);
   Reply(312)
   NAnswer(313,4,Node999)
end

//---

procedure NodeEndDialog begin
   Reply(320)
   if ((cur_map_index != MAP_SPECIAL_ARMY) or (self_elevation == 0)) then begin
   GAnswer(322,4,NodeEndDialog2)
   end
   NAnswer(321,4,Node999)
   NAnswer(323,-3,Node999)
end

procedure NodeEndDialog2 begin
   Reply(324)
   NAnswer(325,4,NodeEndDialog3)
   NAnswer(326,-3,NodeEndDialog3)
end

procedure NodeEndDialog3 begin
   set_local_var(LVAR_Party_Status,-1);
   set_global_var(GVAR_PUERTO_STATUS_PAUL, 1);
   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_TEAM_NUM,NUM_TEAM);
   exp_add(350);
   set_REP(5)
   set_SLAVA(5)
   set_obj_visibility(self_obj, 1);

   call Node999;
end
