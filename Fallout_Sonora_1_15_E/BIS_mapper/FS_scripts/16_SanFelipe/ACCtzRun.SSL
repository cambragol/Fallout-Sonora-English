// Modified heavily for Espanol trait handling - cambragol

procedure start begin
end

procedure map_enter_p_proc begin
   if (is_loading_game == false) then begin
       set_start_home
       if DudeTraitHas(TRAIT_espanol) then begin
       critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_AI_PACKET,AI_HERMO_SOLDIER_ENG);
       end

       if (cur_map_index == MAP_SAN_FELIPE_CITY) then begin
          set_obj_visibility(self_obj, 0);
          if (gvar_bit(GVAR_SANFELIPE_BITS,bit_1) != 0) then begin
          set_obj_visibility(self_obj, 1);
          end
       end
       else begin
          bitDialogExp(bit_1,0)
          bitDialogExp(bit_2,0)
          set_obj_visibility(self_obj, 1);
          if (gvar_bit(GVAR_SANFELIPE_BITS,bit_1) != 0) then begin
          set_obj_visibility(self_obj, 0);
          end
       end
       if (gvar_bit(GVAR_SANFELIPE_BITS,bit_2) != 0) then begin
          set_obj_visibility(self_obj, 1);
       end

       if (getQuest(GVAR_SANFELIPE_QST_RUN) >= qEnd) then begin
          set_obj_visibility(self_obj, 1);
       end
   end
end

procedure look_at_p_proc begin
   //lookProcMsg
   script_overrides;
   if (bitDialog(bit_2) != 0) then begin
   display_mstr(102);
   end else begin
   display_mstr(100);
   end
end

procedure description_p_proc begin
   dsrptProcMsg
end

procedure timed_event_p_proc begin
   // Таймер за номером 1 рарезервирован под перемещение персонажа по локации
   // Таймер за номером 2 рарезервирован под всплывающие реплики
   if (fixed_param == 1) then begin
       if (cur_map_index == MAP_SAN_FELIPE_CITY) then begin
       timer_move_to_home
       end
       else begin
       timer_move_random_home(7)
       end
   end
   if (fixed_param == 2) then begin
       if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCOAST) >= qEnd) then begin
       end
       else begin
         if DudeTraitHas(TRAIT_espanol) then begin
            timer_float_reply(110,113)
         end else begin
            timer_float_reply(120,123)
         end
       end
   end
   if (fixed_param == 3) then begin
       dude_teleport_map(0,0,MAP_SAN_FELIPE_CAVE,0);
   end
end

procedure critter_p_proc begin
   set_critter_options(1,0) //условие нападения (0 личная вражда, 1 вражда клановая, 2 всегда), разворот к ГГ
end

procedure use_obj_on_p_proc begin
   UsedItemToCrit_Proc
end

procedure use_skill_on_p_proc begin
   skillUseSteal
   skillUseFAid
end

procedure pickup_p_proc begin
   pickupProcCritter
end

procedure push_p_proc begin
   push_options(HomeTile,5,-1) // толкать (точка отсчета, макс расстояние, фраза над нпс при толкании), удалить если не надо
end

procedure combat_p_proc begin
   effectAttak(0,0,1,1,1) //отравление min, облучение min, травма ног %, травма рук %, травма глаз %
end

procedure damage_p_proc begin
   set_damage_dude
end

procedure destroy_p_proc begin
   set_gvar_bit_on(GVAR_SANFELIPE_BITS, bit_2);
   kill_critter_opt
end

procedure talk_p_proc begin
   setReaction(0) // Отношение к ГГ (1 - персонаж положительный, -1 отрицательный, 0 нейтральный)
   dialog_proc(0,0,NodeStartDialog,-1,-1)
end

procedure Node998 begin
   set_enemy_dude;
end

procedure Node999 begin
end

procedure NodeStartDialog begin
   if ((bitDialog(bit_1) == 0) and (gvar_bit(GVAR_SANFELIPE_BITS,bit_1) == 0)) then begin
   call NodeFstDialog;
   end
   else begin
   call NodeSndDialog;
   end
end

//--- FIRST DIALOGUE

// Spanish and English entry point
procedure NodeFstDialog begin
   if DudeTraitHas(TRAIT_espanol) then begin
      Reply(200)
      NAnswer(201,0,NodeFstDialog101)
   end
   else begin
      Reply(213)
      NAnswer(214,0,NodeFstDialog101)
   end
end

// Spanish and English
procedure NodeFstDialog101 begin
   if DudeTraitHas(TRAIT_espanol) then begin
      Reply(202)
      NAnswer(203,0,NodeFstDialog102)
   end
   else begin
      zReply(215)
      NAnswer(216,0,NodeFstDialog106)
      NAnswer(217,0,Node999)
   end
end

// Spanish only
procedure NodeFstDialog102 begin
   Reply(204)
   NAnswer(205,0,NodeFstDialog103)
end

// Spanish only
