// extensive changes for Espanol Trait by cambragol

procedure start begin
end

procedure map_enter_p_proc begin
   if (is_loading_game == false) then begin
       set_start_home
       if DudeTraitHas(TRAIT_espanol) then begin
         critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_AI_PACKET,AI_HERMO_SOLDIER_ENG);
       end
       if (getQuest(GVAR_SANFELIPE_QST_RUN) >= qEnd) then begin
         set_obj_visibility(self_obj, 1);
       end
   end
end

procedure look_at_p_proc begin
   lookProcMsg
end

procedure description_p_proc begin
   dsrptProcMsg
end

procedure timed_event_p_proc begin
   // Таймер за номером 1 рарезервирован под перемещение персонажа по локации
   // Таймер за номером 2 рарезервирован под всплывающие реплики
   if (fixed_param == 1) then begin
       timer_move_to_home
   end
   if (fixed_param == 2) then begin
       //timer_float_reply(120,121)
   end
   if (fixed_param == 3) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         KillScorpTail(104) // фраза над жертвой (-1 если не нужна)
      end
      else begin
         KillScorpTail(107) // фраза над жертвой (-1 если не нужна)
      end
   end
end

procedure critter_p_proc begin
   set_critter_options(1,0) //условие нападения (0 личная вражда, 1 вражда клановая, 2 всегда), разворот к ГГ
end

procedure use_obj_on_p_proc begin
   UsedItemToCrit_Proc
   UsedToCrit_Scorp(103,3) // фраза над жертвой (-1 если не нужна), номер таймера
end

procedure use_skill_on_p_proc begin
   skillUseSteal
   skillUseFAid
end

procedure pickup_p_proc begin
   pickupProcCritter
end

procedure combat_p_proc begin
   effectAttak(0,0,1,1,1) //отравление min, облучение min, травма ног %, травма рук %, травма глаз %
end

procedure damage_p_proc begin
   set_damage_dude
end

procedure destroy_p_proc begin
   set_global_var(GVAR_SANFELIPE_STATUS_BOSS, -1);
   set_gvar_bit_off(GVAR_SANFELIPE_BITS, bit_3);
   set_gvar_bit_off(GVAR_SANFELIPE_BITS, bit_4);

   if (getQuest(GVAR_SANFELIPE_QST_FAROLAMPARA) == qStart) then begin
      setQuest(GVAR_SANFELIPE_QST_FAROLAMPARA, qStop);
   end
   if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCOAST) == qStart) then begin
      setQuest(GVAR_SANFELIPE_QST_MONSTRSCOAST, qStop);
   end
   if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCAVE) == qStart) then begin
      setQuest(GVAR_SANFELIPE_QST_MONSTRSCAVE, qStop);
   end
   if (getQuest(GVAR_SANFELIPE_QST_GMAP) == qStart) then begin
      setQuest(GVAR_SANFELIPE_QST_GMAP, qStop);
   end
   if (getQuest(GVAR_SANFELIPE_QST_WATER) == qStart) then begin
      setQuest(GVAR_SANFELIPE_QST_WATER, qStop);
   end

   kill_critter_opt
end

procedure talk_p_proc begin
   ScorpPoisonFlt
   if (getQuest(GVAR_SANFELIPE_QST_RUN) >= qEnd) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         floater(self_obj, 102, COLOR_MSG_NORMAL);
      end
      else begin
         floater(self_obj, 105, COLOR_MSG_NORMAL);
      end
   end
   else if (gvar_bit(GVAR_SANFELIPE_BITS,bit_6) != 0) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         floater(self_obj, 103, COLOR_MSG_NORMAL);
      end
      else begin
         floater(self_obj, 106, COLOR_MSG_NORMAL);
      end
   end
   else begin
      setReaction(0) // Отношение к ГГ (1 - персонаж положительный, -1 отрицательный, 0 нейтральный)
      dialog_proc(0,0,NodeStartDialog,-1,-1)
   end
end

procedure Node998 begin
   set_enemy_dude;
end

procedure Node999 begin
end

procedure NodeStartDialog begin
   if (getQuest(GVAR_SANFELIPE_QST_GMAP) > qZero) then begin
   bitDialogExp(bit_1,0) // уловка для удобства теста в маппере
   end

   if (bitDialog(bit_1) == 0) then begin
   call NodeFstDialog;
   end
   else begin
   call NodeSndDialog;
   end
end

// Spanish dialogue entry point
