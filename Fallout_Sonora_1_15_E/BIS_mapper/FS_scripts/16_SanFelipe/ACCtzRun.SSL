end

//--- ПОВТОРНЫЙ ДИАЛОГ

procedure NodeSndDialog begin
   if (gvar_bit(GVAR_SANFELIPE_BITS,bit_1) != 0) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         zReply(257)
      end else begin
         zReply(255)
      end
   end
   else begin
      if DudeTraitHas(TRAIT_espanol) then begin
         zReply(222)
      end else begin
         zReply(220)
      end
   end

//- quests:
   if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCAVE) == qStart) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         GAnswer(258,4,NodeQst104)
      end
   end

   if (gvar_bit(GVAR_SANFELIPE_BITS,bit_1) == 0) then begin
      if (global_var(GVAR_SANFELIPE_STATUS_MONSTRCOAST) >= SANFELIPE_DEAD_MONSTRCOAST) then begin
         if DudeTraitHas(TRAIT_espanol) then begin
            GAnswer(251,4,NodeQst103)
         end
         else begin
            GAnswer(254,4,NodeQst103)
         end
      end
      else if DudeTraitHas(TRAIT_espanol) then begin
         NAnswer(242,4,NodeQst101)
         NAnswer(249,4,NodeQst102)
      end
   end

//- questions:
   if DudeTraitHas(TRAIT_espanol) then begin
      NAnswer(236,4,NodeAnswer103)
      NAnswer(230,4,NodeAnswer101)
      NAnswer(246,4,NodeAnswer104)
      if (bitDialog(bit_2) == 0) then begin
         NAnswer(223,0,Node999)
      end
      else begin
         NAnswer(221,0,Node999)
      end
   end
   else begin
      NAnswer(436,4,NodeAnswer103)
      NAnswer(430,4,NodeAnswer101)
      if (bitDialog(bit_2) == 0) then begin
         NAnswer(423,0,Node999)
      end
      else begin
         NAnswer(421,0,Node999)
      end
   end
end

