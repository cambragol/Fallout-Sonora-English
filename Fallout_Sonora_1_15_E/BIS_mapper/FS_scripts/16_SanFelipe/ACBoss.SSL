procedure NodeQstFinish begin
   questsCheck := 0;
   if (getQuest(GVAR_SANFELIPE_QST_FAROLAMPARA) >= qEnd) then begin
      if (global_var(GVAR_SANFELIPE_STATUS_LAMPARA) > 0) then begin
      questsCheck += 1;
      end
      else if (global_var(GVAR_SANFELIPE_STATUS_LAMPARA) < 0) then begin
      questsCheck -= 1;
      end
   end

   if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCAVE) >= qEnd) then begin
   questsCheck += 1;
   end

   if (getQuest(GVAR_SANFELIPE_QST_WATER) >= qEnd) then begin
   questsCheck += 1;
   end
   else if (getQuest(GVAR_SANFELIPE_QST_WATER) <= qStop) then begin
   questsCheck -= 1;
   end

   if (questsCheck >= 3) then begin
   call NodeQstFinish2;
   end
   else begin
   call Node999;
   end
end

