procedure NodeAnswer200 begin
   questsCheck := 0;
   if (global_var(GVAR_SANFELIPE_STATUS_LAMPARA) < 0) then begin
   questsCheck += 1;
   end
   if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCOAST) >= qEnd) then begin
   questsCheck += 1;
   end
   if (getQuest(GVAR_SANFELIPE_QST_GMAP) >= qEnd) then begin
   questsCheck += 1;
   end

   Reply(331)
   if (questsCheck>=3) then begin
   NAnswer(347,0,NodeAnswer204)
   end
   else begin
   NAnswerSkill(347,4,NodeAnswer204,SKILL_CONVERSANT,100,333,NodeAnswer201)
   end
   NAnswer(332,0,Node999)
end

