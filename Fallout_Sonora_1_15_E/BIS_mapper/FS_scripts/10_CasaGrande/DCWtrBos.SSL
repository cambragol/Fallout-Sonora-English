procedure start begin
end

procedure map_enter_p_proc begin
   if (is_loading_game == false) then begin
       set_start_home
       if (map_first_run) then begin
       item_add(self_obj,PID_BOOTLE_CAPS,random(80,100))
       end

       set_obj_visibility(self_obj, 0);
       if (getQuest(GVAR_CGRANDE_ATTAK_TO_BAR) == qStart) then begin
       set_obj_visibility(self_obj, 1);
       end
       if (global_var(GVAR_CGRANDE_STATUS_SHEFF) < 0) then begin
       set_obj_visibility(self_obj, 1);
       end
       if (bitGrande_shrf_attak_mer != 0) then begin
       set_obj_visibility(self_obj, 1);
       end
   end
end

procedure look_at_p_proc begin
   lookProcMsg
end

procedure description_p_proc begin
   dsrptProcMsg
end

procedure timed_event_p_proc begin
   // Таймер за номером 1 рарезервирован под перемещение персонажа по локации
   // Таймер за номером 2 рарезервирован под всплывающие реплики
   if (fixed_param == 1) then begin
       timer_move_to_home
   end
   if (fixed_param == 2) then begin
       //timer_float_reply(110,119)
   end
end

procedure critter_p_proc begin
   set_using_stop // привязка хозяина и объекта (удалить, если не нужно)
   set_critter_options(0,0) //условие нападения (0 личная вражда, 1 вражда клановая, 2 всегда), разворот к ГГ
end

procedure use_skill_on_p_proc begin
   skillUseSteal
   skillUseFAid
end

procedure pickup_p_proc begin
   pickupProcCritter
end

procedure use_obj_on_p_proc begin
   UsedItemToCrit_Proc
end

procedure combat_p_proc begin
   effectAttak(0,0,2,2,2) //отравление min, облучение min, травма ног %, травма рук %, травма глаз %
end

procedure damage_p_proc begin
   set_damage_dude
end

procedure destroy_p_proc begin
   dec_global_var(GVAR_CGRANDE_STATUS_CTZN);
   set_global_var(GVAR_CGRANDE_STATUS_SHEFF,-1);
   if (getQuest(GVAR_CGRANDE_WATER_REPAIR) == qStart) then begin
   setQuest(GVAR_CGRANDE_WATER_REPAIR,qStop);
   end
   kill_critter_opt
end

procedure talk_p_proc begin
   if ((global_var(GVAR_CGRANDE_STATUS_SHEFF) <= 0) and (armor_pid_dude_var == PID_ARMOR_ROAD)) then begin
   z_floater(self_obj,103,COLOR_MSG_RED);
   end
   else if ((global_var(GVAR_CGRANDE_STATUS_SHEFF) <= 0) and (global_var(GVAR_TITUL_WARRIOR_ROAD) > 0)) then begin
   z_floater(self_obj,103,COLOR_MSG_RED);
   end
   else begin
   setReaction(0) // Отношение к ГГ (1 - персонаж положительный, -1 отрицательный, 0 нейтральный)
   fracReaction(GVAR_TITUL_ARIZONA_RANGER,-20) // Поправка к отношению за принадлежность к фракциям
   fracReaction(GVAR_TITUL_PHENIX_CULT,20) // Поправка к отношению за принадлежность к фракциям
   fracReaction(GVAR_TITUL_WARRIOR_ROAD,-90) // Поправка к отношению за принадлежность к фракциям
   dialog_proc(0,0,NodeStartDialog,-1,-1)
   end
end

procedure Node998 begin
   setNodeCombat;
end

procedure Node999 begin
end

procedure NodeStartDialog begin
   if (getQuest(GVAR_CGRANDE_WATER_REPAIR) > qStart) then begin
   bitDialogExp(bit_1,0) // эта опция служит только для удобства теста в маппере
   end

   if (bitDialog(bit_1) == 0) then begin
      call NodeFstDialog;
   end
   else if ((bitDialog(bit_6) == 0) and (map_var(MVAR_CGRANDE_WATER_ATTAK_A) < 0)) then begin
      call NodeStopDialog100;
   end
   else begin
      call NodeSndDialog;
   end
end

//--- СТОП-ДИАЛОГ

procedure NodeStopDialog100 begin
   bitDialogExp(bit_6,0)
   Reply(230)
   BAnswerSkill(237,4,NodeStopDialog102,SKILL_CONVERSANT,40,234,NodeStopDialog103)
   zGAnswer(231,4,NodeStopDialog101)
end

procedure NodeStopDialog101 begin
   setBonusReaction(10)
   Reply(232)
   NAnswer(233,4,Node999)
end

procedure NodeStopDialog102 begin
   upCoast := 50;
   item_add(dude_obj,PID_BOOTLE_CAPS,upCoast)
   setBonusReaction(-10)

   Reply(mstr(238)+upCoast+mstr(239))
   NAnswer(240,4,Node999)
end

procedure NodeStopDialog103 begin
   setBonusReaction(-10)
   Reply(235)
   NAnswer(236,4,Node999)
end

//--- ПЕРВЫЙ ДИАЛОГ

procedure NodeFstDialog begin
   bitDialogExp(bit_1,0)
   zReply(200)
   NAnswer(201,4,NodeSndDialog)
   NAnswer(202,-3,NodeSndDialog)
end

//--- ПОВТОРНЫЙ ДИАЛОГ

procedure NodeSndDialog begin
   upCoast := 0;
   if (bitDialog(bit_7) == 0) then begin
   Reply(203)
   bitDialogExp(bit_7,0)
   end
   else if (global_var(GVAR_CGRANDE_STATUS_SHEFF)>0) then begin
   Reply(104)
   end
   else if ((armor_pid_dude_var == PID_ARMOR_POWER_A) or (armor_pid_dude_var == PID_ARMOR_POWER_B) or (armor_pid_dude_var == PID_ARMOR_POWER_C)) then begin
   Reply(223)
   end
   else if (getReaction<0) then begin
   Reply(224)
   end
   else begin
   Reply(220)
   end

   //--- Вопросы:
   NAnswer(260,4,NodeAnswer100)
   if (bitDialog(bit_2) == 0) then begin
   if (global_var(GVAR_CGRANDE_STATUS_MER) < 0) then begin
   if (global_var(GVAR_CGRANDE_STATUS_SHEFF) == 0) then begin
   if (getQuest(GVAR_CGRANDE_ATTAK_TO_BAR) != qZero) then begin
   NAnswer(291,4,NodeAnswer204)
   end
   end
   end
   end
   if (getQuest(GVAR_TWOSUN_QST_LOST_TIN) == qStart) then begin
   NAnswer(250,4,NodeAnswer300)
   end
   if (getQuest(GVAR_MAIN_QUEST_TWOSUN) == qStart) then begin
   NAnswer(253,4,NodeAnswer301)
   end

   //--- квест на починку фильтра:
   if (getQuest(GVAR_CGRANDE_WATER_REPAIR) == qZero) then begin
   NAnswer(300,4,NodeQst001)
   end
   if (getQuest(GVAR_CGRANDE_WATER_REPAIR) == qStart) then begin
   NAnswer(330,4,NodeQst004)
   if (map_var(MVAR_CGRANDE_WATER_REPAIR) > 0) then begin
   GAnswer(333,4,NodeQst005)
   end
   end
   if (getQuest(GVAR_CGRANDE_WATER_REPAIR) >= qEnd) then begin
   NAnswer(300,4,NodeQst000)
   end

   //--- квест магистральщиков:
   if (bitGrande_shrf_attak_mer == 0) then begin
   if (global_var(GVAR_CGRANDE_STATUS_SHEFF) == 0) then begin
   if (global_var(GVAR_CGRANDE_STATUS_MER) == 0) then begin
   if (getQuest(GVAR_CGRANDE_ATTAK_TO_BAR) >= qEnd) then begin
   if (gvar_bit(GVAR_DIALOGS_FLAGS_BIT, bit_28) == 0) then begin
      if (getQuest(GVAR_RAIDER_QST_GRANGE) == qStart) then begin
      NAnswer(353,4,NodeQst202)
      end
      if (getQuest(GVAR_RAIDER_QST_GRANGE) == qZero) then begin
      NAnswer(350,4,NodeQst201)
      end
   end
   end
   end
   end
   end

   NAnswer(221,4,Node999)
   NAnswer(222,-3,Node999)
end

