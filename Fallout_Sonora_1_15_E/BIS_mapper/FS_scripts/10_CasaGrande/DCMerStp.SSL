procedure NodeSndDialog begin
   if ((getQuest(GVAR_CGRANDE_ATTAK_TO_BAR) >= qEnd) and (getQuest(GVAR_CGRANDE_QST_ROADSTOP) == qZero)) then begin
   Reply(231)
   end
   else begin
   Reply(230)
   end

   NAnswer(300,4,NodeAnswer100)
   if (bitDialog(bit_5) == 0) then begin
   NAnswer(310,4,NodeAnswer200)
   end
   if (global_var(GVAR_RAIDER_STATUS_PRISON) == 0) then begin
   if (getQuest(GVAR_RAIDER_QST_PRISON) == qStart) then begin
   NAnswer(270,4,NodeAnswer103)
   end
   end
   NAnswer(232,4,Node999)
   NAnswer(234,-3,Node999)
end

