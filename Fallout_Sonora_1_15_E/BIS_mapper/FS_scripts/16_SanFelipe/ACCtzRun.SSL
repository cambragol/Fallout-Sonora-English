end

// Spanish and English
procedure NodeFstDialog106 begin
   bitDialogExp(bit_1,0)
   if DudeTraitHas(TRAIT_espanol) then begin
      Reply(211)
      NAnswer(212,0,Node999)
   end
   else begin
      Reply(218)
      NAnswer(219,0,Node999)
