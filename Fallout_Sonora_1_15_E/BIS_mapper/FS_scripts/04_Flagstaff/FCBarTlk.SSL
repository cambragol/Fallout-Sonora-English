procedure start begin
end

procedure map_enter_p_proc begin
   if (is_loading_game == false) then begin
       set_start_home
       if (getQuest(GVAR_FLAGSTAFF_SLAVES_RUN) >= qEnd) then begin
       set_obj_visibility(self_obj, 1);
       end
   end
end

procedure look_at_p_proc begin
   lookProcMsg
end

procedure description_p_proc begin
   dsrptProcMsg
end

procedure timed_event_p_proc begin
   // Timer number 1 is reserved for character movement around the location
   // Timer number 2 is reserved for pop-up dialogue
   if (fixed_param == 1) then begin
       timer_move_to_home
   end
   if (fixed_param == 2) then begin
       //timer_float_reply(120,121)
   end
end

procedure critter_p_proc begin
   set_critter_options(0,0) //attack condition (0 personal feud, 1 clan feud, 2 always), turn to GG
end

procedure use_skill_on_p_proc begin
   skillUseSteal
   skillUseFAid
end

procedure pickup_p_proc begin
   pickupProcCritter
end

procedure use_obj_on_p_proc begin
   UsedItemToCrit_Proc
   if (itemTypeUseDude == 2) then begin
      if (bitDialog(bit_3) == 0) then begin
      bitDialogExp(bit_3,0)
      end
   end
end

procedure combat_p_proc begin
   effectAttak(0,0,0,1,0) //poisoning min, radiation min, leg injury %, arm injury %, eye injury %
end

procedure damage_p_proc begin
   set_damage_dude
end

procedure destroy_p_proc begin
   kill_critter_opt
end

procedure talk_p_proc begin
   setReaction(1) // Attitude towards the main character (1 - positive character, -1 negative, 0 neutral)
   dialog_proc(0,0,NodeStartDialog,-1,-1)
end

procedure Node998 begin
   set_enemy_dude;
end

procedure Node999 begin
end

procedure NodeStartDialog begin
   if (bitDialog(bit_1) == 0) then begin
      if (bitDialog(bit_3) == 0) then begin
      call NodeFstDialog101;
      end
      else begin
      call NodeFstDialog201;
      end
   end
   else begin
      call NodeSndDialog;
   end
end

procedure NodeFstDialog101 begin
   if (map_var(MVAR_FLAG_Huligan) >0) then begin
   Reply(203)
   end
   else if (global_var(GVAR_STATUS_FLAGSTAFF_FABER)<0) then begin
   zReply(214)
   end
   else if (global_var(GVAR_TITUL_REBIRTH)>0) then begin
   Reply(213)
   end
   else begin
   zReply(202)
   end

   NAnswer(220,4,NodeFstDialog105)
   if (bitDialog(bit_2) == 0) then begin
   BAnswer(204,4,NodeFstDialog102)
   end else begin
   NAnswer(204,4,Node999)
   end
   NAnswer(260,-3,Node999)
end

procedure NodeFstDialog102 begin
   Reply(205)
   BAnswer(206,4,NodeFstDialog103)
   NAnswer(207,4,Node999)
end

procedure NodeFstDialog103 begin
   Reply(208)
   BAnswer(209,4,NodeFstDialog104)
   NAnswer(210,4,Node999)
end

