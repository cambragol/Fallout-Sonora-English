//---------------------



procedure start begin
end

procedure map_enter_p_proc begin
   if (is_loading_game == false) then begin
       set_start_home
   end
end

procedure look_at_p_proc begin
   lookProcMsg
end

procedure description_p_proc begin
   dsrptProcMsg
end

procedure timed_event_p_proc begin
   // Timer number 1 is reserved for character movement around the location
   // Timer number 2 is reserved for pop-up dialogue
   if (fixed_param == 1) then begin
       timer_move_to_home
   end
   if (fixed_param == 2) then begin
       //timer_float_reply(110,119)
   end
end

procedure critter_p_proc begin
   set_critter_options(1,0) //attack condition (0 personal feud, 1 clan feud, 2 always), turn to GG
   if self_enemy_dude then begin
   BarklyAttakDude
   end
end

procedure use_skill_on_p_proc begin
   skillUseSteal
   skillUseFAid
end

procedure pickup_p_proc begin
   pickupProcCritter
end

procedure use_obj_on_p_proc begin
   UsedItemToCrit_Proc
end

procedure combat_p_proc begin
   effectAttak(0,0,1,1,1) //poisoning min, radiation min, leg injury %, arm injury %, eye injury %
end

procedure damage_p_proc begin
   if (source_obj == dude_obj) then begin
   BarklyAttakDude
   end
   set_damage_dude
end

procedure destroy_p_proc begin
   kill_critter_opt
   kill_critter_BoS_item
end

procedure talk_p_proc begin
   setReaction(0) // Attitude towards the main character (1 - positive character, -1 negative, 0 neutral)
   dialog_proc(0,0,NodeStartDialog,-1,-1)
   /*
   if (global_var(GVAR_PUERTO_DOPUSK)>=0) then begin
   dialog_proc(0,0,NodeStartDialog,-1,-1)
   end
   else begin
   floater(dude_obj,102,COLOR_MSG_RED);
   end
   */
end

procedure Node998 begin
   set_enemy_dude;
end

procedure Node999 begin
end

procedure NodeStartDialog begin
   if (bitDialog(bit_1) == 0) then begin
   call NodeFstDialog;
   end
   else if ((getQuest(GVAR_PUERTO_QST_BELL)>=qEnd) and (bitDialog(bit_4) == 0)) then begin
   call NodeBellEnd;
   end
   else begin
   call NodeSndDialog;
   end
end

procedure NodeBellEnd begin
   bitDialogExp(bit_4,0)
   setBonusReaction(35)
   Reply(352)
   NAnswer(353,4,NodeSndDialog)
   NAnswer(354,-3,NodeSndDialog)
end

//--- FIRST DIALOGUE

procedure NodeFstDialog begin
   bitDialogExp(bit_1,0)
   if (global_var(GVAR_TITUL_BOS)>0) then begin
   zReply(210)
   GAnswer(211,4,NodeFstDialog103)
   BAnswer(213,4,NodeFstDialog104)
   BAnswer(217,-3,NodeFstDialog106)
   end
   else begin
   zReply(200)
   GAnswer(201,4,NodeFstDialog101)
   BAnswer(203,4,NodeFstDialog102b)
   BAnswer(218,-3,NodeFstDialog102)
   end
end

