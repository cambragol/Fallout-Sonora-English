procedure NodeGame begin
   if (getQuest(GVAR_MAIN_QUEST_FLAGSTAFF) < qEnd) then begin
   Reply(351)
   NAnswer(352,4,NodeSndDialog)
   NAnswer(353,4,Node999)
   BAnswer(354,4,Node999)
   end
   else begin
   Reply(355)
   NAnswerSkill(356,1,NodeGame2,SKILL_GAMBLING,50,356,NodeGame3)
   NAnswer(357,4,NodeSndDialog)
   NAnswer(358,4,Node999)
   end
end

