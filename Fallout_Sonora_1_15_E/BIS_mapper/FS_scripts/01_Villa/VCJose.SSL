procedure start begin
end

procedure map_enter_p_proc begin
   if (is_loading_game == false) then begin
       set_start_home
       set_BarterBoxProc(BARTER_TIME) // !duplicate in NodeStartDialog
   end
end

procedure setBarterA begin
         check_restock_item(PID_W_KNIFE, 1,1, 100)
         if (dude_level >= 7) then begin
         check_restock_item(PID_W_MACHETE, 1,1, 100)
         end

         if ((getQuest(GVAR_MAIN_QUEST_FLAGSTAFF) >= qEnd) or (getQuest(GVAR_MAIN_QUEST_TWOSUN) >= qEnd)) then begin
         check_restock_item(PID_M_FRUIT, 5, 5, 100)
         check_restock_item(PID_CORN_FLOUR, 3, 3, 100)
         check_restock_item(PID_M_WATER_FLASK, 2, 2, 100)
         end
         else begin
         check_restock_item(PID_M_FRUIT, 3, 3, 100)
         check_restock_item(PID_CORN_FLOUR, 2, 2, 100)
         end

         //Персонаж не использует крышки от бутылок до финала игры!
         if (global_var(GVAR_GAME_END) != 0) then begin
         if (global_var(GVAR_TITUL_VILLA_DISTROY)>0) then begin
         check_restock_many(400,600)
         end
         end
end

procedure setBarterB begin
   //! пока пусто
   set_BarterDopusk;
end

procedure look_at_p_proc begin
   lookProcMsg
end

procedure description_p_proc begin
   dsrptProcMsg
end

procedure timed_event_p_proc begin
   // Timer number 1 is reserved for character movement around the location
   // Timer number 2 is reserved for pop-up dialogue
   if (fixed_param == 1) then begin
       timer_move_to_home
   end
   if (fixed_param == 2) then begin
       if ((getQuest(GVAR_MAIN_QUEST_FLAGSTAFF) < qEnd) and (getQuest(GVAR_MAIN_QUEST_TWOSUN) < qEnd)) then begin
       timer_float_reply(120,124)
       end
   end
end

procedure critter_p_proc begin
   set_critter_options(3,0) //attack condition (0 personal feud, 1 clan feud, 2 always), turn to GG
end

procedure use_skill_on_p_proc begin
   skillUseSteal
   skillUseFAid
end

procedure pickup_p_proc begin
   pickupProcCritter
end

procedure use_obj_on_p_proc begin
   UsedItemToCrit_Proc
end

procedure combat_p_proc begin
   effectAttak(0,0,0,0,0) //poisoning min, radiation min, leg injury %, arm injury %, eye injury %
end

procedure damage_p_proc begin
   set_damage_dude
end

procedure destroy_p_proc begin
   set_global_var(GVAR_VILLA_STATUS_JOSE,-1);
   kill_critter_opt
   kill_critter_box
   kill_critter_dude_reply(102,102)
end

procedure talk_p_proc begin
   if town_rep_is_vilified then begin
   z_floater(self_obj,105,COLOR_MSG_RED);
   end
   else begin
   setReaction(1) // Отношение к ГГ(1 - персонаж положительный, -1 отрицательный, 0 нейтральный)
   fracReaction(GVAR_TITUL_ARIZONA_RANGER,20) // Поправка к отношению за принадлежность к фракциям
   set_BarterBoxProc(BARTER_TIME) // !duplicate in map_enter_p_proc
   dialog_proc_barter(0,104,NodeStartDialog,-1,-1)
   end
end

procedure Node998 begin
   set_enemy_dude;
end

procedure Node999 begin
end

procedure NodeStartDialog begin
   if ((bitDialog(bit_11) == 0) and ((getQuest(GVAR_MAIN_QUEST_FLAGSTAFF) >= qEnd) or (getQuest(GVAR_MAIN_QUEST_TWOSUN) >= qEnd) or (global_var(GVAR_VILLA_STATUS_PADRE) > 0) or (global_var(GVAR_VILLA_STATUS_MADRE) > 0))) then begin
   call NodeSndDialog2;
   end
   else if (bitDialog(bit_1) == 0) then begin
   call NodeFstDialog;
   end
   else if ((global_var(GVAR_TITUL_REBIRTH) > 0) and (bitDialog(bit_12) == 0)) then begin
   call NodeSndDialogRebish;
   end
   else begin
   call NodeSndDialog;
   end
end

