//--- REPEAT DIALOGUE

procedure NodeSndDialog begin
   if (global_var(GVAR_TITUL_BOS)>0) then begin
   zReply(221)
   end
   else begin
   zReply(220)
   end

   NAnswer(230,4,NodeAnswer101)
   NAnswer(234,4,NodeAnswer100)
   //? боевой рассказ на 100 опыта
   if (getQuest(GVAR_PUERTO_QST_BELL) < qEnd) then begin
   if (gvar_bit(GVAR_DIALOGS_FLAGS_BIT, bit_32) != 0) then begin
   if (map_var(MVAR_PUERTO_MEDIC_BELL_INFO)==0) then begin
   NAnswer(340,4,NodeAnswer300)
   end
   end
   end
   if (local_var(LVAR_Game_Point)<10) then begin
   NAnswerSkill(250,4,NodeGame,SKILL_GAMBLING,50,250,NodeGame2)
   end
   else begin
   NAnswer(270,4,NodeGame9)
   end

   NAnswer(222,4,NodeSndDialog2)
   NAnswer(226,-3,Node999)
end

procedure NodeSndDialog2 begin
   Reply(223)
   NAnswer(224,4,Node999)
end

//--- АЗАРТНАЯ ИГРА

procedure NodeGame begin
   gameStatus := 0;
   Reply(251)
   if (item_amnt(dude_obj,PID_BOOTLE_CAPS)>=25) then begin
   NAnswer(253,4,NodeGame5)
   end
   NAnswer(254,4,NodeGame3)
   NAnswer(252,4,Node999)
end

procedure NodeGame2 begin
   Reply(257)
   NAnswer(258,4,Node999)
   BAnswer(259,4,Node999)
end

procedure NodeGame3 begin
   zReply(255)
   if (item_amnt(dude_obj,PID_BOOTLE_CAPS)>=50) then begin
   NAnswer(253,4,NodeGame4)
   end
   NAnswer(252,4,Node999)
end

procedure NodeGame4 begin
   gameStatus := 1;
   call NodeGame5;
end

procedure NodeGame5 begin
   Reply(260)
   NAnswer(261,4,NodeGame6)
   NAnswer(262,4,Node999)
end

procedure NodeGame6 begin
   if (has_skill(dude_obj, SKILL_GAMBLING) >= random(20,120)) then begin
   call NodeGame7;
   end
   else begin
   call NodeGame8;
   end
end

procedure NodeGame7 begin
   if (gameStatus == 0) then begin
   item_add(dude_obj,PID_AMMO_5_MM,1)
   end
   else begin
   item_add(dude_obj,PID_M_IRP,1)
   end
   exp_add(35);
   inc_local_var(LVAR_Game_Point);
   zReply(263)
   NAnswer(264,4,Node999)
   BAnswer(265,4,Node999)
end

procedure NodeGame8 begin
   if (gameStatus == 0) then begin
   item_remove(dude_obj,PID_BOOTLE_CAPS,25)
   end
   else begin
   item_remove(dude_obj,PID_BOOTLE_CAPS,50)
   end
   dec_local_var(LVAR_Game_Point);
   Reply(266)
   NAnswer(267,4,Node999)
   BAnswer(268,4,Node999)
end

procedure NodeGame9 begin
   Reply(271)
   NAnswer(272,4,Node999)
end

