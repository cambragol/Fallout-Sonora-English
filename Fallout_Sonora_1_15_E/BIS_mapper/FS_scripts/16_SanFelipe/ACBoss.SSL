#define basarec_x         284
#define basarec_y         1432

#define felipe_reconned    (wm_get_subtile_state(basarec_x-100, basarec_y-100) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-100, basarec_y-50) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-100, basarec_y) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-100, basarec_y+50) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-100, basarec_y+100) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-50, basarec_y-100) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-50, basarec_y-50) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-50, basarec_y) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-50, basarec_y+50) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x-50, basarec_y+100) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x, basarec_y-100) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x, basarec_y-50) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x, basarec_y+50) > KNOWNTILETYPE) and \
                           (wm_get_subtile_state(basarec_x, basarec_y+100) > KNOWNTILETYPE)

procedure NodeSndDialog begin
   if DudeTraitHas(TRAIT_espanol) then begin
      if (get_REP>=15) then begin
         Reply(250)
      end
      else if (get_REP<0) then begin
         Reply(251)
      end
      else begin
         Reply(252)
      end
   end
   else begin
      if (get_REP>=15) then begin
         zReply(254)
      end
      else if (get_REP<0) then begin
         Reply(255)
      end
      else begin
         Reply(256)
      end
   end

   //- местные квесты:
   if (getQuest(GVAR_SANFELIPE_QST_FAROLAMPARA) == qStart) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         if (global_var(GVAR_SANFELIPE_STATUS_LAMPARA) > 0) then begin
            GAnswer(270,0,NodeQst100)
         end
         else if (global_var(GVAR_SANFELIPE_STATUS_LAMPARA) < 0) then begin
            BAnswer(278,0,NodeQst102)
         end
         NAnswer(274,0,NodeQst101)
      end
      else begin
         if (global_var(GVAR_SANFELIPE_STATUS_LAMPARA) > 0) then begin
            GAnswer(670,0,NodeQst100)
         end
         else if (global_var(GVAR_SANFELIPE_STATUS_LAMPARA) < 0) then begin
            BAnswer(678,0,NodeQst102)
         end
      end
   end

   if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCOAST) == qStart) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         if (global_var(GVAR_SANFELIPE_STATUS_MONSTRCOAST) >= SANFELIPE_DEAD_MONSTRCOAST) then begin
            GAnswer(280,0,NodeQst200)
         end
         NAnswer(284,0,NodeQst201)
      end
      else begin
         if (global_var(GVAR_SANFELIPE_STATUS_MONSTRCOAST) >= SANFELIPE_DEAD_MONSTRCOAST) then begin
            GAnswer(680,0,NodeQst200)
         end
      end
   end

   if (getQuest(GVAR_SANFELIPE_QST_MONSTRSCAVE) == qStart) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         if (getQuest(GVAR_SANFELIPE_DESTROY_CAVE) >= qEnd) then begin
            GAnswer(424,0,NodeQst203)
         end
         else if (global_var(GVAR_SANFELIPE_STATUS_MONSTRCAVE) >= SANFELIPE_DEAD_MONSTRCAVE) then begin
            zGAnswer(425,0,NodeQst203)
         end
         NAnswer(420,0,NodeQst202)
      end
      else begin
         if (getQuest(GVAR_SANFELIPE_DESTROY_CAVE) >= qEnd) then begin
            GAnswer(824,0,NodeQst203)
         end
         else if (global_var(GVAR_SANFELIPE_STATUS_MONSTRCAVE) >= SANFELIPE_DEAD_MONSTRCAVE) then begin
            GAnswer(825,0,NodeQst203)
         end
      end
   end

   if (getQuest(GVAR_SANFELIPE_QST_GMAP) == qStart) then begin
      if (felipe_reconned) then begin
         if DudeTraitHas(TRAIT_espanol) then begin
            GAnswer(290,0,NodeQst300)
            if (getQuest(GVAR_SANFELIPE_QST_RUN) == qStart) then begin
            BAnswer(298,0,NodeQst306)
            end
            NAnswer(294,0,NodeQst301)
         end
         else begin
            GAnswer(590,0,NodeQst300)
            if (getQuest(GVAR_SANFELIPE_QST_RUN) == qStart) then begin
            BAnswer(598,0,NodeQst306)
            end
         end
      end
   end
   
   if (getQuest(GVAR_SANFELIPE_QST_WATER) == qStart) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         if (map_var(MVAR_FELIPE_WATER_SVR_AMNT) >= FELIPE_WATER_SVR_AMNT) then begin
            GAnswer(404,0,NodeQst304)
         end
         else begin
            BAnswer(408,0,NodeQst305)
         end
      end
      else begin
         if (map_var(MVAR_FELIPE_WATER_SVR_AMNT) >= FELIPE_WATER_SVR_AMNT) then begin
            GAnswer(804,0,NodeQst304)
         end
         else begin
            BAnswer(808,0,NodeQst305)
         end
      end
   end

   // Should be spanish trait only??
   if (getQuest(GVAR_SANFELIPE_QST_RUN) == qStart) then begin
      if (gvar_bit(GVAR_SANFELIPE_BITS,bit_6) == 0) then begin
         if DudeTraitHas(TRAIT_espanol) then begin
            NAnswer(330,0,NodeAnswer200)
         end
      end
   end

   //- questions
   if (gvar_bit(GVAR_SANFELIPE_BITS,bit_3) == 0) then begin
      if DudeTraitHas(TRAIT_espanol) then begin
         NAnswer(305,0,NodeAnswer102)
      end 
      else begin
         NAnswer(300,0,NodeAnswer101)
      end
   end

   //- Brotherhood of Steel quest
   if (getQuest(GVAR_PUERTO_QST_SANFELIPE_PIP) == qStart) then begin
      if (gvar_bit(GVAR_SANFELIPE_BITS,bit_4) == 0) then begin
         if (gvar_bit(GVAR_SANFELIPE_BITS,bit_6) == 0) then begin
            if DudeTraitHas(TRAIT_espanol) then begin
               NAnswer(350,0,NodeBOS101)
            end
            else begin
               NAnswer(750,0,NodeBOS101)
            end
         end
      end
   end

   if DudeTraitHas(TRAIT_espanol) then begin
      NAnswer(257,0,Node999)
   end
   else begin
      NAnswer(253,0,Node999)
   end
end

