//--- REPEAT DIALOGUE

procedure NodeSndDialog begin
   if (getReaction >=0) then begin
   zReply(250)
   end
   else if (getReaction <= -50) then begin
   Reply(263)
   end
   else begin
   zReply(251)
   end
   NAnswer(253,4,NodeAnswer)

   if ((getQuest(GVAR_VILLA_MARAUDERS) == qZero) and (getQuest(GVAR_VILLA_METEO) == qZero)) then begin
   NAnswer(310,4,NodeQuest)
   end

   if (getQuest(GVAR_VILLA_MARAUDERS) == qStart) then begin
   if (global_var(GVAR_VILLA_MARAUDERS_RUN) != 0) then begin
   GAnswer(318,4,NodeQuest4)
   end
   end

   if (getQuest(GVAR_VILLA_METEO) == qStart) then begin
   if (map_var(MVAR_Plaza_Meteo) != 0) then begin
   GAnswer(321,4,NodeQuest5)
   end
   end

   if (bitDialog(bit_13) == 0) then begin
   NAnswer(350,4,NodeGame)
   end

   NAnswer(252,4,Node999)
   NAnswer(258,-3,Node999)
end

